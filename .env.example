# ResearchScope environment variables
# Copy this file to .env and fill in values as needed.
# None of these are required for the MVP — arXiv and ACL Anthology are public.

# Optional: Semantic Scholar API key for citation data
# SEMANTIC_SCHOLAR_KEY=your_key_here

# Optional: OpenAI-compatible key for LLM-powered enrichment (future)
# OPENAI_API_KEY=your_key_here

# Optional: Anthropic API key (future)
# ANTHROPIC_API_KEY=your_key_here

# ── Railway backend ───────────────────────────────────────────────────────────
# PostgreSQL URL from Railway dashboard (used by pipeline to sync papers)
# RAILWAY_DATABASE_URL=postgresql://user:pass@host:port/dbname

# FastAPI backend settings (set these in Railway environment variables)
# DATABASE_URL=postgresql://user:pass@host:port/dbname   (Railway provides this automatically)
# JWT_SECRET=your-secret-key-here
# JWT_TTL_HOURS=72
# PIPELINE_SECRET=your-pipeline-trigger-secret
# GITHUB_TOKEN=ghp_...                                   (fine-grained token with actions:write)
# GITHUB_REPO=kishormorol/ResearchScope
# GITHUB_WORKFLOW=pipeline.yml

# ── Chat with Paper (OpenAI Responses API) ──────────────────────────────────
# Uses OPENAI_API_KEY above. Keep the key server-side and never expose it in JS.
# CHAT_ENABLED=false
# CHAT_REQUEST_TIMEOUT_SECONDS=90
# CHAT_DAILY_MESSAGE_LIMIT=20
# CHAT_MAX_CONCURRENT_TURNS_PER_USER=2
# CHAT_USER_REQUESTS_PER_MINUTE=10
# CHAT_IP_REQUESTS_PER_MINUTE=30
# CHAT_PREPARES_PER_USER_PER_DAY=5
# CHAT_PREPARES_PER_IP_PER_DAY=20
# CHAT_PDF_REQUESTS_PER_IP_PER_MINUTE=60
# CHAT_GLOBAL_DAILY_PROVIDER_REQUEST_BUDGET=500
# CHAT_GLOBAL_DAILY_PROVIDER_TOKEN_BUDGET=2000000
# CHAT_MAX_INPUT_CHARS=4000
# CHAT_MAX_OUTPUT_TOKENS=1200

# PDF safety, delivery, and in-process caching
# CHAT_MAX_PDF_MB=15
# CHAT_PDF_TIMEOUT_SECONDS=60
# CHAT_PDF_ALLOWED_HOSTS=
# CHAT_PDF_DIRECT_URLS=true
# CHAT_PDF_CACHE_TTL_SECONDS=3600
# CHAT_PDF_CACHE_MAX_ENTRIES=4
# CHAT_PDF_RESPONSE_CACHE_SECONDS=3600

# Paper extraction and retrieval
# CHAT_CHILD_CHUNK_TOKENS=600
# CHAT_PARENT_CHUNK_TOKENS=1500
# CHAT_CHUNK_OVERLAP_TOKENS=100
# CHAT_EMBEDDINGS_ENABLED=true
# CHAT_EMBEDDING_BATCH_SIZE=32
# CHAT_EMBEDDING_TIMEOUT_SECONDS=60
# CHAT_LEXICAL_CANDIDATES=20
# CHAT_SEMANTIC_CANDIDATES=20
# CHAT_FINAL_EVIDENCE_COUNT=10
# CHAT_FULL_CONTEXT_MAX_TOKENS=60000
# CHAT_VISUAL_PAGES_ENABLED=true
# CHAT_MAX_VISUAL_PAGES=3
# CHAT_VISUAL_PAGE_SCALE=1.5

# OpenAI chat and embedding configuration
# OPENAI_CHAT_MODEL=gpt-5.6-terra
# OPENAI_REASONING_EFFORT=low
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_EMBEDDING_DIMENSIONS=256
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# Comma-separated frontend origins accepted by the backend.
# ALLOWED_ORIGINS=https://kishormorol.github.io,http://127.0.0.1:8080,http://localhost:8080

# Optional local metadata fallback for production papers missing from the local DB.
# PAPER_CATALOG_FALLBACK_URL=https://researchscope-production.up.railway.app
